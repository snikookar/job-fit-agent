# Copy to `.env` and fill in what you need. Everything is optional:
# with no API keys the app runs in offline "heuristic" mode (good for trying the UI, not for real use).

# --- Database ---------------------------------------------------------------
# Default: SQLite file in backend/data/. For pgvector (docker compose), use:
# DATABASE_URL=postgresql+psycopg://jobfit:jobfit@localhost:5432/jobfit

# --- LLMs (any OpenAI-compatible API) ----------------------------------------
# auto | api | heuristic
LLM_PROVIDER=auto

# Writer: DeepSeek (https://platform.deepseek.com)
WRITER_BASE_URL=https://api.deepseek.com
WRITER_API_KEY=
WRITER_MODEL=deepseek-chat

# Judge: a different model family on purpose. Zhipu GLM (https://open.bigmodel.cn)
# Check your provider's docs for current model names.
JUDGE_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
JUDGE_API_KEY=
JUDGE_MODEL=glm-4.6

# --- Retrieval ----------------------------------------------------------------
# auto: bge-m3 / bge-reranker-v2-m3 if `uv sync --extra ml` was run, otherwise lightweight fallbacks.
EMBEDDING_BACKEND=auto
RERANKER_BACKEND=auto

# --- Agent ----------------------------------------------------------------------
MAX_DRAFT_ROUNDS=2
JUDGE_THRESHOLD=0.5
GAP_THRESHOLD=0.5

# --- Optional -------------------------------------------------------------------
# GITHUB_TOKEN=            # higher rate limit for README ingestion
# LANGFUSE_PUBLIC_KEY=     # tracing (uv sync --extra tracing)
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3001
